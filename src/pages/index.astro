---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import ContractorSection from '../components/ContractorSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Hero from '../components/Hero.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import UspSection from '../components/UspSection.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
---

<BaseLayout
  title="Timmerfabriek Friesland voor houten maatwerk | Sint Nyk"
  description="Houten kozijnen, deuren en schuifpuien op maat, gemaakt in onze werkplaats in Sint Nicolaasga. Voor particulieren en aannemers in Friesland en Noord-Nederland."
>
  <main id="main-content" tabindex="-1">
    <Hero />
    <UspSection />
    <ProductsSection />
    <WorkflowSection />
    <AboutSection />
    <ProjectsSection />
    <ContractorSection />
    <FaqSection />
  </main>
</BaseLayout>
