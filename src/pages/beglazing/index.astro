---
import ProductDetailPage from '../../components/ProductDetailPage.astro';
import { productDetails } from '../../data/productDetails';
import BaseLayout from '../../layouts/BaseLayout.astro';

const product = productDetails.beglazing;
---

<BaseLayout
  title="Beglazing met HR++ of triple glas | Timmerfabriek Sint Nyk"
  description="Nieuwe beglazing met HR++ of triple glas, voor nieuwe kozijnen, deuren en schuifpuien of voor uw bestaande houten kozijn."
>
  <main id="main-content" tabindex="-1">
    <ProductDetailPage {...product} />
