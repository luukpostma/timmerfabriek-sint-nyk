---
import draaikiepraamImage from '../../assets/images/Draaikiepraam.webp';
import vastGlasKozijnImage from '../../assets/images/Vastglaskozijn.webp';
import draairaamImage from '../../assets/images/Draairaam.webp';
import deurkozijnenImage from '../../assets/images/Deurkozijnen.webp';
import binnendeurkozijnenImage from '../../assets/images/Binnendeurkozijnen.webp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryHero from '../../components/CategoryHero.astro';
import ContractorSection from '../../components/ContractorSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import ProductDetailBenefitsSection from '../../components/ProductDetailBenefitsSection.astro';
import WindowTypesSection from '../../components/WindowTypesSection.astro';
import { mainNavigation } from '../../data/navigation';

const page = mainNavigation.find((item) => item.href === '/kozijnen/');

if (!page) throw new Error('Navigatiedata voor de kozijnenpagina ontbreekt.');

const benefits = [
  {
    title: 'Isolatie',
    description:
      'Houten kozijnen isoleren van nature goed en zijn eenvoudig te combineren met HR++ of triple glas.',
  },
  {
    title: 'Uitstraling',
    description:
      'U kiest zelf profiel, kleur en indeling, zodat het kozijn aansluit bij zowel klassieke als moderne gevels.',
  },
  {
    title: 'Volledig maatwerk',
    description:
      'Ieder kozijn wordt in onze werkplaats op maat gemaakt, afgestemd op de afmetingen en situatie van uw project.',
  },
];

const windowTypeDescriptions = [
  'Een kozijn zonder te openen delen, voor veel lichtinval en een rustig gevelbeeld.',
  'Kiepen voor ventilatie op een kier, of volledig openen voor frisse lucht en makkelijk schoonmaken.',
  'Een raam dat volledig openzwaait, voor veel frisse lucht en vrij zicht naar buiten.',
  'Een kozijn op maat voor uw buitendeur, afgestemd op de deur, gevelopening en situatie.',
  'Een nauwkeurig kozijn tussen binnendeur en wand, afgestemd op wanddikte en deuropening.',
];

const windowTypeLabels = [
  'Vast glas',
  'Kiepen & draaien',
  'Volledig openen',
  'Voor buitendeuren',
  'Voor binnendeuren',
];
---

<BaseLayout
  title="Houten kozijnen op maat | Timmerfabriek Sint Nyk"
  description="Bekijk onze houten kozijnen op maat: van vast glas tot draaikiepramen, draairamen en deurkozijnen. Gemaakt in onze eigen werkplaats in Sint Nicolaasga, Friesland."
>
  <main id="main-content" tabindex="-1">
    <CategoryHero title={page.label} />
    <WindowTypesSection
      items={page.children ?? []}
      introduction="Van vast glas tot draaikiepramen en deurkozijnen: bekijk de mogelijkheden en kies het type dat past bij uw project."
      labels={windowTypeLabels}
      descriptions={windowTypeDescriptions}
      imageOverrides={{
        '/kozijnen/vast-glas-kozijnen/': {
          image: vastGlasKozijnImage,
          alt: 'Houten vast glas kozijn van Timmerfabriek Sint Nyk',
        },
        '/kozijnen/draaikiepramen/': {
          image: draaikiepraamImage,
          alt: 'Houten draaikiepraam van Timmerfabriek Sint Nyk',
        },
        '/kozijnen/draairamen/': {
          image: draairaamImage,
          alt: 'Houten draairaam van Timmerfabriek Sint Nyk',
        },
        '/kozijnen/deurkozijnen/': {
          image: deurkozijnenImage,
          alt: 'Houten deurkozijn van Timmerfabriek Sint Nyk',
        },
        '/kozijnen/binnendeurkozijnen/': {
          image: binnendeurkozijnenImage,
          alt: 'Houten binnendeurkozijn van Timmerfabriek Sint Nyk',
        },
      }}
    />
    <ProductDetailBenefitsSection
      heading="Waarom houten kozijnen?"
      introduction="Houten kozijnen op maat, gemaakt in onze eigen werkplaats in Sint Nicolaasga."
      benefits={benefits}
    />
    <ContractorSection />
    <FaqSection />
  </main>
</BaseLayout>
