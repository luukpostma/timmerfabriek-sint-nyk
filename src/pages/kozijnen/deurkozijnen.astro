---
import ProductDetailPage from '../../components/ProductDetailPage.astro';
import { productDetails } from '../../data/productDetails';
import BaseLayout from '../../layouts/BaseLayout.astro';

const product = productDetails.deurkozijn;
---

<BaseLayout
  title="Houten deurkozijn op maat | Timmerfabriek Sint Nyk"
  description="Een houten deurkozijn vormt de stevige omlijsting rond uw buitendeur, op maat gemaakt in onze eigen werkplaats."
>
  <main id="main-content" tabindex="-1">
    <ProductDetailPage {...product} />
  </main>
</BaseLayout>
