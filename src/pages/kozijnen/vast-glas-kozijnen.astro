---
import ProductDetailPage from '../../components/ProductDetailPage.astro';
import { productDetails } from '../../data/productDetails';
import BaseLayout from '../../layouts/BaseLayout.astro';

const product = productDetails.vastGlasKozijn;
---

<BaseLayout
  title="Vast glas kozijn op maat | Timmerfabriek Sint Nyk"
  description="Een vast glas kozijn zonder te openen delen: veel lichtinval en een rustig gevelbeeld, volledig op maat gemaakt."
>
  <main id="main-content" tabindex="-1">
    <ProductDetailPage {...product} />
  </main>
</BaseLayout>
