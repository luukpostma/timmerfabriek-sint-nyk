---
import ProductDetailPage from '../../components/ProductDetailPage.astro';
import { productDetails } from '../../data/productDetails';
import BaseLayout from '../../layouts/BaseLayout.astro';

const product = productDetails.binnendeurkozijn;
---

<BaseLayout
  title="Houten binnendeurkozijn op maat | Timmerfabriek Sint Nyk"
  description="Een houten binnendeurkozijn als nauwkeurige overgang tussen deur, wand en interieur, volledig op maat."
>
  <main id="main-content" tabindex="-1">
    <ProductDetailPage {...product} />
  </main>
</BaseLayout>
