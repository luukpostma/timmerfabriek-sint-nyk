---
import contractorHeroImage from '../../assets/images/Aannemer-hero.webp';
import AboutSection from '../../components/AboutSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import ProductDetailHero from '../../components/ProductDetailHero.astro';
import ProductsSection from '../../components/ProductsSection.astro';
import UspSection from '../../components/UspSection.astro';
import WorkflowSection from '../../components/WorkflowSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const workflowSteps = [
  {
    title: 'Aanvraag & tekeningen',
    description:
      'U levert de bouwtekeningen en projectspecificaties aan. Op basis daarvan beoordelen we het project, stemmen we de uitvoering af en werken we het maatwerk technisch uit voor productie.',
    items: [
      'Tekeningen & maten beoordelen',
      'Wensen en uitvoering bespreken',
      'Technische uitgangspunten bepalen',
    ],
  },
  {
    title: 'Afstemming & offerte',
    description:
      'We stemmen de technische details en uitvoering af en vertalen deze naar een duidelijke offerte.',
    items: [
      'Materialen en detaillering afstemmen',
      'Duidelijke offerte ontvangen',
      'Planning en levering afspreken',
    ],
  },
  {
    title: 'Productie & levering',
    description:
      'Na akkoord produceren we het maatwerk zelf in onze werkplaats in Sint Nicolaasga, volgens de gemaakte afspraken.',
    items: [
      'Maatwerk zorgvuldig produceren',
      'Product en afwerking controleren',
      'Levering volgens de afgesproken planning',
    ],
  },
];

const contractorFaqs = [
  {
    question: 'In welke regio leveren jullie voor aannemersprojecten?',
    answer:
      'We richten ons vooral op Noord-Nederland: Friesland, Groningen, Drenthe en Flevoland. Projecten daarbuiten bespreken we graag, maar dit is niet onze actieve regio.',
  },
  {
    question: 'Kunnen jullie vanaf bouwtekeningen produceren?',
    answer:
      'Ja. Vaak ontvangen we eerst een voorlopige tekening om het project te beoordelen en de uitvoering af te stemmen. Met de definitieve bouwtekening werken we het houten maatwerk vervolgens technisch uit en maken we het productiegereed.',
  },
  {
    question: 'Kunnen jullie grotere aantallen leveren?',
    answer:
      'Ja. Naast enkelstuks produceren we ook grotere en seriematige aantallen. We bespreken vroegtijdig de fasering en levermomenten die bij de bouwplanning passen.',
  },
  {
    question: 'Welke beglazing kunnen jullie leveren?',
    answer:
      'We leveren HR++ en triple glas, op maat besteld bij onze glasleverancier en verwerkt in uw kozijnen, deuren of schuifpuien. Per project adviseren we welke glassoort past bij uw situatie.',
  },
  {
    question: 'Kunnen kozijnen afgewerkt worden geleverd?',
    answer:
      'Ja. Afhankelijk van de projectspecificatie leveren we kozijnen behandeld, beglaasd en voorzien van passend beslag. De gewenste uitvoering leggen we vast in de offerte.',
  },
  {
    question: 'Wat is de levertijd voor een aannemersproject?',
    answer:
      'De levertijd hangt af van de omvang, uitvoering, materiaalkeuzes en de actuele productieplanning. Na technische afstemming ontvangt u een planning met afgesproken levermomenten.',
  },
  {
    question: 'Werken jullie alleen voor aannemers of ook voor particulieren?',
    answer:
      'We werken voor zowel aannemers als particulieren. Voor aannemers bieden we extra afstemming rondom tekeningen, grotere aantallen, fasering en levering op de bouw.',
  },
];
---

<BaseLayout
  title="Houten maatwerk voor aannemers | Timmerfabriek Sint Nyk"
  description="Timmerfabriek Sint Nyk maakt houten kozijnen, deuren en schuifpuien voor aannemers, van enkelstuks tot seriematig maatwerk. Eigen productie in Sint Nicolaasga."
  footerCtaHeading="Een project om te bespreken?"
  footerCtaButtonLabel="Bespreek uw project"
>
  <main id="main-content" tabindex="-1">
    <ProductDetailHero
      title="Maatwerk voor aannemers"
      description="Voor nieuwbouw, renovatie en seriematige projecten maken we houten kozijnen, deuren en puien op maat in onze eigen werkplaats in Sint Nicolaasga. Van enkelstuks tot grotere aantallen, met technische afstemming en levering volgens een vooraf afgesproken planning."
      breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Voor aannemers' }]}
      image={contractorHeroImage}
      imageAlt="Houten maatwerkproductie voor aannemers"
      ctaLabel="Bespreek uw project"
    />
    <UspSection />
    <ProductsSection
      heading="Wat kunnen we voor u produceren?"
      introduction="Bekijk onze houten maatwerkproducten en glasmogelijkheden voor renovatie, verbouwing en nieuwbouw."
    />
    <WorkflowSection
      heading="Van aanvraag tot levering"
      introduction="Een helder proces, korte lijnen en duidelijke afspraken. Van tekeningen en technische afstemming tot productie en levering volgens planning."
      steps={workflowSteps}
    />
    <AboutSection />
    <FaqSection
      heading="Vragen voor aannemers"
      introduction="Bekijk de antwoorden op vragen die we regelmatig krijgen over maatwerk, levering en planning."
      items={contractorFaqs}
    />
  </main>
</BaseLayout>
