---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryOverview from '../components/CategoryOverview.astro';
import { placeholderPages, type NavigationItem } from '../data/navigation';
import { getProductByHref } from '../data/products';

export function getStaticPaths() {
  return placeholderPages.map((page) => ({
    params: { slug: page.href.replace(/^\//, '').replace(/\/$/, '') },
    props: { page },
  }));
}

interface Props {
  page: NavigationItem;
}

const { page } = Astro.props;
const categoryProduct = page.children ? getProductByHref(page.href) : undefined;
---

<BaseLayout title={`${page.label} | Timmerfabriek Sint Nyk`}>
  <main>
    {categoryProduct ? (
      <CategoryOverview page={page} product={categoryProduct} />
    ) : (
      <div class="placeholder-page container">
        <h1>{page.label}</h1>
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .placeholder-page {
    padding-block: 4rem;
  }
</style>
