---
import achterdeurenImage from '../../assets/images/Achtedeuren.webp';
import binnendeurenImage from '../../assets/images/Binnendeuren.webp';
import garagedeurenImage from '../../assets/images/Garagedeuren.webp';
import voordeurenImage from '../../assets/images/Voordeur.webp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryHero from '../../components/CategoryHero.astro';
import ContractorSection from '../../components/ContractorSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import ProductDetailBenefitsSection from '../../components/ProductDetailBenefitsSection.astro';
import WindowTypesSection from '../../components/WindowTypesSection.astro';
import { mainNavigation } from '../../data/navigation';

const page = mainNavigation.find((item) => item.href === '/deuren/');

if (!page) throw new Error('Navigatiedata voor de deurenpagina ontbreekt.');

const benefits = [
  {
    title: 'Isolatie',
    description:
      'Een nauwkeurig passende deur beperkt tocht bij de opening, en glazen delen zijn te combineren met HR++ of triple glas.',
  },
  {
    title: 'Uitstraling',
    description:
      'U kiest zelf vlakverdeling, kleur en glas, zodat de deur past bij de architectuur van uw woning of pand.',
  },
  {
    title: 'Volledig maatwerk',
    description:
      'Iedere deur wordt in onze werkplaats op maat gemaakt, afgestemd op de opening en de gewenste uitvoering.',
  },
];

const doorTypeDescriptions = [
  'Een houten voordeur op maat, met veel keuze in vlakverdeling, kleur en glas voor een uitnodigende entree.',
  'Een houten achterdeur op maat voor de dagelijkse doorgang tussen woning, tuin, schuur of bijkeuken.',
  'Houten garagedeuren op maat, afgestemd op de breedte, hoogte en uitstraling van uw garage.',
  'Een houten binnendeur op maat, met veel keuze in profiel, kleur en glas voor uw interieur.',
];

const doorTypeLabels = ['Entree', 'Dagelijks gebruik', 'Grote opening', 'Voor binnen'];
---

<BaseLayout
  title="Houten deuren op maat | Timmerfabriek Sint Nyk"
  description="Bekijk onze houten deuren op maat: van voordeuren tot achterdeuren, garagedeuren en binnendeuren. Gemaakt in onze werkplaats in Sint Nicolaasga."
>
  <main id="main-content" tabindex="-1">
    <CategoryHero title={page.label} />
    <WindowTypesSection
      items={page.children ?? []}
      eyebrow="Soorten deuren"
      heading="Welke deur past bij uw project?"
      introduction="Van voordeuren tot garagedeuren: bekijk de mogelijkheden en kies het type dat past bij uw project."
      labels={doorTypeLabels}
      descriptions={doorTypeDescriptions}
      imageOverrides={{
        '/deuren/voordeuren/': {
          image: voordeurenImage,
          alt: 'Moderne donkerblauwe houten voordeur met zijlichten',
        },
        '/deuren/achterdeuren/': {
          image: achterdeurenImage,
          alt: 'Houten achterdeur van Timmerfabriek Sint Nyk',
        },
        '/deuren/garagedeuren/': {
          image: garagedeurenImage,
          alt: 'Donkere houten garagedeuren in een gemetselde gevel',
        },
        '/deuren/binnendeuren/': {
          image: binnendeurenImage,
          alt: 'Witte houten binnendeuren in een licht interieur',
        },
      }}
      contactHeading="Zit uw deur er niet tussen?"
      contactText="Neem vrijblijvend contact met ons op om de mogelijkheden voor uw maatwerkdeur te bespreken."
    />
    <ProductDetailBenefitsSection
      heading="Waarom houten deuren?"
      introduction="Houten deuren op maat, gemaakt in onze eigen werkplaats in Sint Nicolaasga voor binnen- en buitentoepassingen."
      benefits={benefits}
    />
    <ContractorSection />
    <FaqSection />
  </main>
</BaseLayout>
