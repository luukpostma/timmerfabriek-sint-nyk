---
import ProductDetailPage from '../../components/ProductDetailPage.astro';
import { productDetails } from '../../data/productDetails';
import BaseLayout from '../../layouts/BaseLayout.astro';

const product = productDetails.voordeur;
---

<BaseLayout
  title="Houten voordeur op maat | Timmerfabriek Sint Nyk"
  description="Een houten voordeur op maat, met veel keuze in vlakverdeling, kleur en glas voor een uitnodigende entree. Gemaakt in onze eigen werkplaats."
>
  <main id="main-content" tabindex="-1">
    <ProductDetailPage {...product} />
  </main>
</BaseLayout>
