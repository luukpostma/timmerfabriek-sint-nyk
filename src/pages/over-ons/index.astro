---
import loodsImage from '../../assets/images/loods.webp';
import AboutHighlightsSection from '../../components/AboutHighlightsSection.astro';
import AboutStorySection from '../../components/AboutStorySection.astro';
import ContractorSection from '../../components/ContractorSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import ProductDetailHero from '../../components/ProductDetailHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Over ons | Timmerfabriek Sint Nyk"
  description="Timmerfabriek Sint Nyk is een kleinschalige timmerfabriek in Sint Nicolaasga met eigen werkplaats en spuiterij, en ruim 20 jaar vakervaring in houten maatwerk."
>
  <main id="main-content" tabindex="-1">
    <ProductDetailHero
      title="Timmerfabriek Sint Nyk"
      description="Een kleinschalige timmerfabriek in Sint Nicolaasga, Friesland. In onze eigen werkplaats en spuiterij maken we houten kozijnen, deuren, schuifpuien en vouwwanden op maat, met ruim 20 jaar vakervaring binnen het team."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Over ons' },
      ]}
      image={loodsImage}
      imageAlt="De loods van Timmerfabriek Sint Nyk"
    />
    <AboutHighlightsSection />
    <AboutStorySection />
    <ContractorSection />
    <FaqSection />
  </main>
</BaseLayout>
