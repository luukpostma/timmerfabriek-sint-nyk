---
import ArrowRight from '../assets/icons/arrow-right.svg';
import Mail from '../assets/icons/mail.svg';
import MapPin from '../assets/icons/map-pin.svg';
import Phone from '../assets/icons/phone.svg';
---

<section class="contact-section" aria-labelledby="contact-heading">
  <div class="container contact-section__layout">
    <div class="contact-section__content">
      <nav class="contact-section__breadcrumb text-eyebrow" aria-label="Broodkruimelpad">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>

      <h1 id="contact-heading">Contact</h1>
      <p>
        Heeft u een vraag of wilt u de mogelijkheden voor uw project bespreken? Neem gerust
        contact met ons op. We denken graag met u mee.
      </p>

      <address class="contact-section__details">
        <a href="tel:+31610478836">
          <span class="contact-section__icon"><Phone aria-hidden="true" /></span>
          <span>06 10 47 88 36</span>
        </a>
        <a href="mailto:info@timmerfabrieksintnyk.nl">
          <span class="contact-section__icon"><Mail aria-hidden="true" /></span>
          <span>info@timmerfabrieksintnyk.nl</span>
        </a>
        <div>
          <span class="contact-section__icon"><MapPin aria-hidden="true" /></span>
          <span>Bovenkuier 38, 8521 MG Sint Nicolaasga</span>
        </div>
      </address>
    </div>

    <form
      class="contact-form"
      action="https://api.web3forms.com/submit"
      method="post"
      data-contact-form
    >
      <input type="hidden" name="access_key" value="f21b887f-8c85-4ae4-b2b8-1f6cbf966b75" />
      <input type="hidden" name="subject" value="Nieuwe contactaanvraag via timmerfabrieksintnyk.nl" />
      <input class="contact-form__botcheck" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      <h2>Neem contact met ons op</h2>

      <div class="contact-form__fields">
        <div class="contact-form__field">
          <label for="first-name">Voornaam <span aria-hidden="true">*</span></label>
          <input id="first-name" name="name" type="text" autocomplete="given-name" placeholder="Voornaam" required />
        </div>

        <div class="contact-form__field">
          <label for="last-name">Achternaam <span aria-hidden="true">*</span></label>
          <input id="last-name" name="last_name" type="text" autocomplete="family-name" placeholder="Achternaam" required />
        </div>

        <div class="contact-form__field contact-form__field--wide">
          <label for="email">E-mail <span aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="naam@mail.nl" required />
        </div>

        <div class="contact-form__field contact-form__field--wide">
          <label for="phone">Telefoonnummer</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="06-12345678" />
        </div>

        <div class="contact-form__field contact-form__field--wide">
          <label for="message">Bericht <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="5" placeholder="Typ hier uw bericht..." required></textarea>
        </div>
      </div>

      <button class="contact-form__submit" type="submit">
        <span data-submit-label>Versturen</span>
        <ArrowRight aria-hidden="true" />
      </button>
      <p
        id="contact-form-status"
        class="contact-form__status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        data-contact-status
      ></p>
      <noscript>
        <p class="contact-form__noscript">
          JavaScript is uitgeschakeld. Het formulier blijft bruikbaar, maar na verzending verlaat
          u tijdelijk deze website voor de bevestigingspagina van Web3Forms. Uw ingevulde gegevens
          worden via Web3Forms naar Timmerfabriek Sint Nyk doorgestuurd.
        </p>
      </noscript>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const submitButton = form.querySelector<HTMLButtonElement>('[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-contact-status]');

    if (!submitButton || !submitLabel || !status) return;

    let isSubmitting = false;

    const setStatus = (state: 'idle' | 'validation' | 'pending' | 'success' | 'error', message = '') => {
      status.dataset.state = state;
      status.textContent = message;
    };

    form.addEventListener(
      'invalid',
      () => {
        if (!isSubmitting) {
          setStatus('validation', 'Controleer de gemarkeerde velden en vul de verplichte gegevens correct in.');
        }
      },
      true,
    );

    form.addEventListener('input', () => {
      if (status.dataset.state === 'validation') {
        setStatus('idle');
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (isSubmitting) return;

      if (!form.checkValidity()) {
        setStatus('validation', 'Controleer de gemarkeerde velden en vul de verplichte gegevens correct in.');
        form.reportValidity();
        return;
      }

      isSubmitting = true;
      submitButton.disabled = true;
      submitLabel.textContent = 'Bezig met versturen…';
      form.setAttribute('aria-busy', 'true');
      setStatus('pending', 'Uw bericht wordt verstuurd…');

      try {
        let response: Response;

        try {
          response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
        } catch {
          setStatus(
            'error',
            'Er is geen verbinding met de verzenddienst. Controleer uw internetverbinding en probeer opnieuw.',
          );
          return;
        }

        let result: { success?: boolean } | null = null;

        try {
          result = await response.json();
        } catch {
          setStatus(
            'error',
            'De verzenddienst gaf een ongeldige reactie. Probeer het later opnieuw of neem telefonisch contact op.',
          );
          return;
        }

        if (response.status === 429) {
          setStatus('error', 'Er zijn te veel verzendpogingen gedaan. Wacht enige tijd en probeer het daarna opnieuw.');
          return;
        }

        if (response.status >= 500) {
          setStatus(
            'error',
            'De verzenddienst is tijdelijk niet beschikbaar. Probeer het later opnieuw of neem telefonisch contact op.',
          );
          return;
        }

        if (!response.ok || result?.success !== true) {
          setStatus(
            'error',
            'De verzenddienst kon uw gegevens niet verwerken. Controleer de velden en probeer opnieuw.',
          );
          return;
        }

        form.reset();
        setStatus('success', 'Bedankt! Uw bericht is succesvol verstuurd.');
      } finally {
        isSubmitting = false;
        submitButton.disabled = false;
        submitLabel.textContent = 'Versturen';
        form.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .contact-section {
    position: relative;
    padding-block: 4rem;
    overflow: hidden;
    color: var(--color-white);
    background-color: var(--color-primary);
  }

  .contact-section::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--color-hero-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-hero-grid) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
  }

  .contact-section::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--color-primary),
      transparent 4.5rem,
      transparent calc(100% - 4.5rem),
      var(--color-primary)
    );
  }

  .contact-section__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 4rem;
  }

  .contact-section__content {
    align-self: start;
  }

  .contact-section__breadcrumb {
    margin-bottom: 1rem;
  }

  .contact-section__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-section__breadcrumb li + li::before {
    margin-right: 0.375rem;
    color: rgb(255 255 255 / 64%);
    content: '/';
  }

  .contact-section__breadcrumb a {
    color: var(--color-white);
    text-decoration: none;
  }

  .contact-section__breadcrumb a:hover {
    color: var(--color-secondary);
  }

  .contact-section__breadcrumb a:focus-visible,
  .contact-section__details a:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 4px;
  }

  .contact-section h1 {
    color: var(--color-white);
  }

  .contact-section__content > p {
    max-width: 36rem;
    margin-top: 1rem;
    color: rgb(255 255 255 / 88%);
  }

  .contact-section__details {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
    font-style: normal;
  }

  .contact-section__details a,
  .contact-section__details > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    color: var(--color-white);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .contact-section__details a {
    width: fit-content;
    transition: color 200ms ease-out;
  }

  .contact-section__details a:hover {
    color: var(--color-secondary);
  }

  .contact-section__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 0.5rem;
    color: var(--color-secondary);
    background-color: var(--color-white);
  }

  .contact-section__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .contact-form {
    padding: 2rem;
    border-radius: 0.75rem;
    color: var(--color-heading);
    background-color: var(--color-white);
  }

  .contact-form__botcheck {
    display: none;
  }

  .contact-form h2 {
    margin-bottom: 2rem;
    font-family: var(--font-family-body);
    font-size: var(--text-h4-size);
    line-height: var(--text-h4-line-height);
  }

  .contact-form__fields {
    display: grid;
    gap: 1.5rem;
  }

  .contact-form__field {
    display: grid;
    gap: 0.5rem;
  }

  .contact-form label {
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
  }

  .contact-form label span {
    color: var(--color-secondary);
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #D4D4D4;
    border-radius: 0.5rem;
    color: var(--color-heading);
    background-color: var(--color-white);
    transition:
      border-color 200ms ease-out,
      box-shadow 200ms ease-out;
  }

  .contact-form input {
    min-height: 3rem;
  }

  .contact-form textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #858585;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    border-color: var(--color-secondary);
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgb(32 147 98 / 16%);
  }

  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.5rem;
    margin-top: 2rem;
    padding: 1rem 1.5rem;
    border: 0;
    border-radius: 9999px;
    font-family: var(--font-family-ui);
    font-size: var(--text-button-size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-button-line-height);
    color: var(--color-white);
    background-color: var(--color-secondary);
    transition: background-color 200ms ease-out;
  }

  .contact-form__submit:hover {
    background-color: var(--color-secondary-hover);
  }

  .contact-form__submit:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .contact-form__submit:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .contact-form__submit :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 200ms ease-out;
  }

  .contact-form__submit:hover :global(svg) {
    transform: translateX(4px);
  }

  .contact-form__status {
    min-height: var(--text-body-line-height);
    margin-top: 1rem;
    font-size: var(--text-body-small-size);
    line-height: var(--text-body-small-line-height);
  }

  .contact-form__status[data-state='success'] {
    color: var(--color-secondary);
  }

  .contact-form__status[data-state='error'] {
    color: #B42318;
  }

  .contact-form__status[data-state='validation'] {
    color: #B42318;
  }

  .contact-form__noscript {
    margin-top: 1rem;
    font-size: var(--text-body-small-size);
    line-height: var(--text-body-small-line-height);
    color: var(--color-text);
  }

  @media (min-width: 64rem) {
    .contact-section {
      padding-block: 6rem;
    }

    .contact-section__layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: 6rem;
    }

    .contact-section__content {
      padding-top: 0.25rem;
    }

    .contact-form__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-form__field--wide {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-section__details a,
    .contact-form input,
    .contact-form textarea,
    .contact-form__submit,
    .contact-form__submit :global(svg) {
      transition: none;
    }

    .contact-form__submit:hover :global(svg) {
      transform: none;
    }
  }
</style>
