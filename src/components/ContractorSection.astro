---
import { Image } from 'astro:assets';
import contractorImage from '../assets/images/Aannemer-hero.webp';
import Button from './Button.astro';
---

<section class="contractor-section" aria-labelledby="contractor-heading">
  <Image
    class="contractor-section__background"
    src={contractorImage}
    alt=""
    widths={[768, 1024, 1440]}
    sizes="100vw"
    loading="lazy"
    aria-hidden="true"
  />

  <div class="container contractor-section__container">
    <div class="contractor-section__card">
      <span class="contractor-section__eyebrow text-eyebrow">Voor aannemers</span>
      <h2 id="contractor-heading">Wilt u een groot project met ons bespreken?</h2>
      <p>
        Voor nieuwbouw, renovatie of seriematig maatwerk denken we graag mee over uitvoering,
        planning en levering.
      </p>
      <Button class="contractor-section__button" href="/voor-aannemers/" arrow>
        Bespreek uw project
      </Button>
    </div>
  </div>
</section>

<style>
  .contractor-section {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 42.75rem;
    align-items: center;
    overflow: hidden;
    padding-block: var(--space-section-y);
    background-color: #000;
  }

  .contractor-section__background {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.4;
  }

  .contractor-section__container {
    position: relative;
    z-index: 1;
  }

  .contractor-section__card {
    display: grid;
    width: 100%;
    padding: 2rem;
    border-radius: 0.75rem;
    background-color: var(--color-primary);
  }

  .contractor-section__eyebrow {
    width: fit-content;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-white);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-white);
  }

  .contractor-section h2 {
    margin-bottom: 1.5rem;
    color: var(--color-white);
  }

  .contractor-section p {
    color: var(--color-white);
  }

  :global(.contractor-section__button.button) {
    width: 100%;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .contractor-section {
      min-height: 37rem;
    }

    .contractor-section__card {
      max-width: 41rem;
      margin-inline: auto;
      padding: 2.5rem;
    }

    :global(.contractor-section__button.button) {
      width: fit-content;
    }
  }

  @media (min-width: 64rem) {
    .contractor-section__card {
      margin-inline: 2rem auto;
    }
  }

  @media (min-width: 80rem) {
    .contractor-section {
      min-height: 43.625rem;
    }

    .contractor-section__card {
      max-width: 45rem;
      padding: 4rem;
    }
  }
</style>
