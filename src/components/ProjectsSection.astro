---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import workshopImage from '../assets/images/blog-placeholder.jpg';
import Button from './Button.astro';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

---

<section class="projects-overview" aria-labelledby="recent-projects-heading">
  <div class="container">
    <div class="projects-overview__header">
      <div class="projects-overview__intro">
        <span class="projects-overview__eyebrow text-eyebrow">Projecten</span>
        <h2 id="recent-projects-heading">Recente projecten</h2>
        <p>
          Bekijk een selectie van projecten die we met aandacht en vakmanschap hebben gerealiseerd.
        </p>
      </div>

      <Button class="projects-overview__cta" href="/projecten/" arrow>
        Bekijk alle projecten
      </Button>
    </div>

    <div class="projects-overview__grid">
      <Image
        class="projects-overview__workshop-image"
        src={workshopImage}
        alt="Vakman meet hout op in de werkplaats"
        widths={[416, 592]}
        sizes="(min-width: 64rem) 416px, calc(100vw - 32px)"
        loading="lazy"
      />

      <ul class="projects-overview__list">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} horizontal />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .projects-overview {
    padding-block: 4rem;
    background-color: var(--color-background);
  }

  .projects-overview__header,
  .projects-overview__intro {
    display: grid;
  }

  .projects-overview__intro {
    max-width: 43rem;
  }

  .projects-overview__eyebrow {
    width: fit-content;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
    background-color: var(--color-white);
  }

  .projects-overview__eyebrow {
    margin-bottom: 0.75rem;
  }

  .projects-overview h2 {
    margin-bottom: 1rem;
  }

  :global(.projects-overview__cta.button) {
    width: 100%;
    margin-top: 2rem;
    background-color: var(--color-primary);
  }

  :global(.projects-overview__cta.button:hover:not(.button--disabled)) {
    background-color: var(--color-sub-navigation-background);
  }

  .projects-overview__grid {
    display: grid;
    gap: 2rem;
    margin-top: 4rem;
  }

  .projects-overview :global(.projects-overview__workshop-image) {
    order: 2;
    width: 100%;
    height: 16rem;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  .projects-overview__list {
    display: grid;
    order: 1;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .projects-overview {
      padding-block: 6rem;
    }

    .projects-overview__header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 3rem;
    }

    .projects-overview h2 {
      margin-bottom: 1.5rem;
    }

    :global(.projects-overview__cta.button) {
      width: auto;
      margin-top: 0;
    }

    .projects-overview__grid {
      grid-template-columns: minmax(0, 9fr) minmax(0, 5fr);
    }

    .projects-overview :global(.projects-overview__workshop-image) {
      height: 100%;
      min-height: 0;
    }

    .projects-overview__list {
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }

    .projects-overview__list > li {
      min-height: 0;
      height: 100%;
    }

    .projects-overview__list :global(.project-card) {
      height: 100%;
    }
  }
</style>
