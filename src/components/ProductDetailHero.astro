---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs: BreadcrumbItem[];
  image: ImageMetadata;
  imageAlt: string;
}

const { title, description, breadcrumbs, image, imageAlt } = Astro.props;
---

<section class="product-detail-hero" aria-labelledby="product-detail-hero-heading">
  <div class="container product-detail-hero__layout">
    <div class="product-detail-hero__content">
      <nav class="product-detail-hero__breadcrumb" aria-label="Broodkruimelpad">
        <ol>
          {breadcrumbs.map((item, index) => (
            <li aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>
              {item.href ? <a href={item.href}>{item.label}</a> : item.label}
            </li>
          ))}
        </ol>
      </nav>

      <h1 id="product-detail-hero-heading">{title}</h1>
      <p>{description}</p>
      <Button href="/contact/" arrow>Offerte aanvragen</Button>
    </div>

    <Image
      class="product-detail-hero__image"
      src={image}
      alt={imageAlt}
      widths={[480, 640, 768]}
      sizes="(min-width: 64rem) 38rem, calc(100vw - 32px)"
      loading="eager"
    />
  </div>
</section>

<style>
  .product-detail-hero {
    position: relative;
    padding-block: 4rem;
    overflow: hidden;
    color: var(--color-white);
    background-color: var(--color-primary);
  }

  .product-detail-hero::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--color-hero-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-hero-grid) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
  }

  .product-detail-hero::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--color-primary),
      transparent 4.5rem,
      transparent calc(100% - 4.5rem),
      var(--color-primary)
    );
  }

  .product-detail-hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
  }

  .product-detail-hero__content {
    display: grid;
    align-content: center;
    justify-items: start;
  }

  .product-detail-hero__breadcrumb {
    margin-bottom: 1rem;
  }

  .product-detail-hero__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-detail-hero__breadcrumb li {
    font-family: var(--font-family-body);
    font-size: var(--text-eyebrow-size);
    line-height: var(--text-eyebrow-line-height);
  }

  .product-detail-hero__breadcrumb li + li::before {
    margin-right: 0.375rem;
    color: rgb(255 255 255 / 64%);
    content: '/';
  }

  .product-detail-hero__breadcrumb a {
    color: var(--color-white);
    text-decoration: none;
  }

  .product-detail-hero__breadcrumb a:hover {
    color: var(--color-secondary);
  }

  .product-detail-hero__breadcrumb a:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 4px;
  }

  .product-detail-hero h1 {
    color: var(--color-white);
  }

  .product-detail-hero p {
    max-width: 36rem;
    margin-top: 1rem;
    color: var(--color-white);
  }

  .product-detail-hero :global(.button) {
    margin-top: 2rem;
  }

  .product-detail-hero :global(.product-detail-hero__image) {
    width: 100%;
    height: 17.5rem;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .product-detail-hero {
      padding-block: 6rem;
    }

    .product-detail-hero__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 6rem;
    }

    .product-detail-hero :global(.product-detail-hero__image) {
      height: 24rem;
    }
  }
</style>
