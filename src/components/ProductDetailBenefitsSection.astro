---
import House from '../assets/icons/house.svg';
import RulerDimensionLine from '../assets/icons/ruler-dimension-line.svg';
import ThermometerSun from '../assets/icons/thermometer-sun.svg';

interface Benefit {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  introduction: string;
  benefits: Benefit[];
}

const { heading, introduction, benefits } = Astro.props;
const icons = [ThermometerSun, House, RulerDimensionLine];
---

<section class="detail-benefits" aria-labelledby="detail-benefits-heading">
  <div class="container">
    <header class="detail-benefits__header">
      <span class="detail-benefits__eyebrow text-eyebrow">Waarom</span>
      <h2 id="detail-benefits-heading">{heading}</h2>
      <p>{introduction}</p>
    </header>

    <ul class="detail-benefits__list">
      {
        benefits.map(({ title, description }, index) => {
          const Icon = icons[index] ?? RulerDimensionLine;

          return (
            <li>
              <span class="detail-benefits__icon">
                <Icon aria-hidden="true" />
              </span>
              <h3>{title}</h3>
              <p>{description}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .detail-benefits {
    padding-block: 4rem;
    background-color: var(--color-background);
  }

  .detail-benefits__header {
    display: grid;
    justify-items: center;
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
  }

  .detail-benefits__eyebrow {
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
    background-color: var(--color-white);
  }

  .detail-benefits h2 {
    margin-bottom: 1rem;
  }

  .detail-benefits__list {
    display: grid;
    gap: 1.5rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .detail-benefits__list li {
    display: grid;
    justify-items: center;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    text-align: center;
    background-color: var(--color-white);
  }

  .detail-benefits__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.5rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-secondary);
    background-color: var(--color-white);
  }

  .detail-benefits__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .detail-benefits__list h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-family-body);
    font-size: var(--text-h5-size);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-h5-line-height);
  }

  @media (min-width: 64rem) {
    .detail-benefits {
      padding-block: 6rem;
    }

    .detail-benefits h2 {
      margin-bottom: 1.5rem;
    }

    .detail-benefits__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 4rem;
    }

    .detail-benefits__list li {
      min-height: 19rem;
      align-content: center;
      padding: 3rem 2rem;
    }
  }
</style>
