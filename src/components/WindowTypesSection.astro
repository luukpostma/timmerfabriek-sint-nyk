---
import type { NavigationItem } from '../data/navigation';
import type { ImageMetadata } from 'astro';
import placeholderImage from '../assets/images/place-holder.jpg';
import Button from './Button.astro';
import ProductCard from './ProductCard.astro';
import type { ProductCardItem } from '../data/products';
import { productDescription } from '../data/products';

interface Props {
  items: NavigationItem[];
  eyebrow?: string;
  heading?: string;
  introduction?: string;
  labels?: string[];
  contactHeading?: string;
  contactText?: string;
  imageOverrides?: Record<string, { image: ImageMetadata; alt: string }>;
}

const {
  items,
  eyebrow = 'Soorten kozijnen',
  heading = 'Welk kozijn past bij uw project?',
  introduction = 'Bekijk onze houten maatwerkproducten en glasmogelijkheden voor renovatie, verbouwing en nieuwbouw.',
  labels = ['Maatwerk', 'Stijlvol & modern', 'Populair', 'Maatwerk', 'Stijlvol & modern'],
  contactHeading = 'Zit uw kozijn er niet tussen?',
  contactText = 'Neem vrijblijvend contact met ons op om uw mogelijkheden te bespreken.',
  imageOverrides = {},
} = Astro.props;
const products: ProductCardItem[] = items.map((item, index) => {
  const imageOverride = imageOverrides[item.href];

  return {
    title: item.label,
    eyebrow: labels[index] ?? 'Maatwerk',
    description: productDescription,
    href: item.href,
    image: imageOverride?.image ?? placeholderImage,
    alt: imageOverride?.alt ?? `Tijdelijke afbeelding voor ${item.label}`,
    type: 'product',
  };
});
---

<section class="window-types" aria-labelledby="window-types-heading">
  <div class="container">
    <header class="window-types__header">
      <span class="window-types__eyebrow text-eyebrow">{eyebrow}</span>
      <h2 id="window-types-heading">{heading}</h2>
      <p>{introduction}</p>
    </header>

    <ul class="window-types__grid">
      {products.map((product) => (
        <li><ProductCard item={product} /></li>
      ))}

      <li class="window-types__contact-card">
        <span class="window-types__contact-eyebrow text-eyebrow">Mogelijkheden</span>
        <h3>{contactHeading}</h3>
        <p>{contactText}</p>
        <Button class="window-types__button" href="/contact/" arrow>
          Bespreek de mogelijkheden
        </Button>
      </li>
    </ul>
  </div>
</section>

<style>
  .window-types {
    padding-block: 4rem;
    background-color: var(--color-white);
  }

  .window-types__header {
    display: grid;
    max-width: 43rem;
  }

  .window-types__eyebrow,
  .window-types__contact-eyebrow {
    width: fit-content;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
  }

  .window-types__eyebrow {
    margin-bottom: 0.75rem;
  }

  .window-types h2 {
    margin-bottom: 1rem;
  }

  .window-types__grid {
    display: grid;
    gap: 2rem;
    margin: 4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .window-types__grid :global(.product-card) {
    height: 100%;
  }

  .window-types__contact-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-radius: 0.75rem;
    color: var(--color-white);
    background-color: var(--color-primary);
  }

  .window-types__contact-eyebrow {
    align-self: flex-start;
    margin-bottom: 0.75rem;
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .window-types__contact-card h3 {
    margin-bottom: 1.5rem;
    font-size: var(--text-h4-size);
    line-height: var(--text-h4-line-height);
    color: var(--color-white);
  }

  .window-types__contact-card p {
    color: var(--color-white);
  }

  :global(.window-types__button.button) {
    width: 100%;
    align-self: end;
    margin-top: auto;
  }

  @media (min-width: 48rem) {
    .window-types__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .window-types {
      padding-block: 6rem;
    }

    .window-types h2 {
      margin-bottom: 1.5rem;
    }

    .window-types__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

  }
</style>
