---
import { Image } from 'astro:assets';
import House from '../assets/icons/house.svg';
import RulerDimensionLine from '../assets/icons/ruler-dimension-line.svg';
import ThermometerSun from '../assets/icons/thermometer-sun.svg';
import woodDetail from '../assets/images/hout-detail.jpg';
import type { ImageMetadata } from 'astro';

interface Benefit {
  title: string;
  description: string;
}

interface Props {
  heading?: string;
  introduction?: string;
  benefits?: Benefit[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const defaultBenefits = [
  {
    title: 'Isolatie',
    description: 'Houten kozijnen bieden goede isolatie en dragen bij aan comfortabel wonen.',
  },
  {
    title: 'Uitstraling',
    description: 'Hout geeft iedere woning een natuurlijke, warme en tijdloze uitstraling.',
  },
  {
    title: 'Volledig maatwerk',
    description: 'Ieder kozijn wordt afgestemd op uw woning, wensen en technische situatie.',
  },
];

const icons = [ThermometerSun, House, RulerDimensionLine];
const {
  heading = 'Waarom houten kozijnen?',
  introduction = 'Houten kozijnen, deuren en schuifpuien op maat. Gemaakt in onze eigen werkplaats in Sint Nicolaasga.',
  benefits = defaultBenefits,
  image = woodDetail,
  imageAlt = 'Detail van een houten kozijn',
} = Astro.props;
---

<section class="why-windows" aria-labelledby="why-windows-heading">
  <div class="container why-windows__layout">
    <div class="why-windows__content">
      <span class="why-windows__eyebrow text-eyebrow">Waarom</span>
      <h2 id="why-windows-heading">{heading}</h2>
      <p>{introduction}</p>

      <ul class="why-windows__benefits">
        {benefits.map(({ title, description }, index) => {
          const Icon = icons[index] ?? RulerDimensionLine;

          return (
            <li>
              <span class="why-windows__icon"><Icon aria-hidden="true" /></span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>

    <Image
      class="why-windows__image"
      src={image}
      alt={imageAlt}
      widths={[548, 768]}
      sizes="(min-width: 64rem) 548px, calc(100vw - 32px)"
      loading="lazy"
    />
  </div>
</section>

<style>
  .why-windows {
    padding-block: 4rem;
    background-color: var(--color-background);
  }

  .why-windows__layout,
  .why-windows__content {
    display: grid;
  }

  .why-windows__layout {
    gap: 4rem;
  }

  .why-windows__eyebrow {
    width: fit-content;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
    background-color: var(--color-white);
  }

  .why-windows h2 {
    margin-bottom: 1rem;
  }

  .why-windows__benefits {
    display: grid;
    gap: 2rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .why-windows__benefits li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }

  .why-windows__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-secondary);
    background-color: var(--color-white);
  }

  .why-windows__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .why-windows__benefits h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-family-body);
    font-size: var(--text-body-size);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-body-line-height);
  }

  .why-windows__benefits p {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
  }

  .why-windows :global(.why-windows__image) {
    width: 100%;
    height: 28rem;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .why-windows {
      padding-block: 6rem;
    }

    .why-windows__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 6rem;
    }

    .why-windows h2 {
      margin-bottom: 1.5rem;
    }

    .why-windows :global(.why-windows__image) {
      height: 34rem;
    }
  }
</style>
