---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import AboutSection from './AboutSection.astro';
import FaqSection from './FaqSection.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<article class="project-detail">
  <header class="container project-detail__header">
    <span class="project-detail__category text-eyebrow">{project.data.category}</span>
    <h1>{project.data.title}</h1>
    <p>{project.data.description}</p>
    <div class="project-detail__body">
      <Content />
    </div>
  </header>

  <div class="container project-detail__media">
    <Image
      class="project-detail__image"
      src={project.data.image}
      alt={project.data.imageAlt}
      widths={[640, 960, 1280]}
      sizes="(min-width: 80rem) 1216px, (min-width: 48rem) calc(100vw - 64px), calc(100vw - 32px)"
      loading="eager"
    />
  </div>

  <AboutSection buttonLabel="Meer over onze timmerfabriek" />
  <FaqSection />
</article>

<style>
  .project-detail__header {
    display: grid;
    justify-items: start;
    padding-block: 4rem;
  }

  .project-detail__category {
    width: fit-content;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
    background-color: var(--color-white);
  }

  .project-detail h1 {
    margin-bottom: 1rem;
  }

  .project-detail__header p {
    max-width: 45rem;
  }

  .project-detail__media {
    padding-bottom: 4rem;
  }

  .project-detail :global(.project-detail__image) {
    display: block;
    width: 100%;
    height: 18rem;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  .project-detail__body {
    display: grid;
    width: 100%;
    gap: 1.5rem;
    max-width: 50rem;
    margin-top: 2rem;
    justify-self: start;
    text-align: left;
  }

  .project-detail__body :global(p) {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .project-detail :global(.project-detail__image) {
      height: 30rem;
    }
  }

  @media (min-width: 64rem) {
    .project-detail__header {
      padding-block: 6rem;
    }

    .project-detail h1 {
      max-width: 48rem;
      margin-bottom: 1.5rem;
    }

    .project-detail__media {
      padding-bottom: 6rem;
    }

    .project-detail :global(.project-detail__image) {
      height: 35rem;
    }
  }
</style>
