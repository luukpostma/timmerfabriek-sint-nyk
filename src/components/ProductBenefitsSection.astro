---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PlusCircle from '../assets/icons/plus-circle.svg';

interface Benefit {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  introduction: string;
  benefits: Benefit[];
  image: ImageMetadata;
  imageAlt: string;
}

const { heading, introduction, benefits, image, imageAlt } = Astro.props;
---

<section class="product-benefits" aria-labelledby="product-benefits-heading">
  <div class="container product-benefits__layout">
    <div class="product-benefits__content">
      <span class="product-benefits__eyebrow text-eyebrow">Waarom</span>
      <h2 id="product-benefits-heading">{heading}</h2>
      <p>{introduction}</p>

      <ul class="product-benefits__list">
        {benefits.map(({ title, description }) => (
          <li>
            <span class="product-benefits__icon"><PlusCircle aria-hidden="true" /></span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <Image
      class="product-benefits__image"
      src={image}
      alt={imageAlt}
      widths={[548, 768]}
      sizes="(min-width: 64rem) 548px, calc(100vw - 32px)"
      loading="lazy"
    />
  </div>
</section>

<style>
  .product-benefits {
    padding-block: 4rem;
    background-color: var(--color-background);
  }

  .product-benefits__layout,
  .product-benefits__content {
    display: grid;
  }

  .product-benefits__content {
    align-content: start;
    justify-items: start;
  }

  .product-benefits__layout {
    gap: 4rem;
  }

  .product-benefits__eyebrow {
    width: fit-content;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
    background-color: var(--color-white);
  }

  .product-benefits h2 {
    margin-bottom: 1rem;
  }

  .product-benefits__list {
    display: grid;
    gap: 2rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product-benefits__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }

  .product-benefits__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-secondary);
    background-color: var(--color-white);
  }

  .product-benefits__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .product-benefits__list h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-family-body);
    font-size: var(--text-body-size);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-body-line-height);
  }

  .product-benefits :global(.product-benefits__image) {
    width: 100%;
    height: 28rem;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .product-benefits {
      padding-block: 6rem;
    }

    .product-benefits__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
      gap: 6rem;
    }

    .product-benefits h2 {
      margin-bottom: 1.5rem;
    }

    .product-benefits :global(.product-benefits__image) {
      height: 100%;
      min-height: 34rem;
    }
  }
</style>
