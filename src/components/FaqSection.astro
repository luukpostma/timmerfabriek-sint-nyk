---
import { getCollection, render } from 'astro:content';
import ChevronDown from '../assets/icons/chevron-down.svg';
import ChevronUp from '../assets/icons/chevron-up.svg';

const faqEntries = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
const faqs = await Promise.all(
  faqEntries.map(async (faq) => ({
    ...faq,
    Content: (await render(faq)).Content,
  })),
);
---

<section class="faq-section" aria-labelledby="faq-heading">
  <div class="container faq-section__layout">
    <div class="faq-section__intro">
      <span class="faq-section__eyebrow text-eyebrow">FAQ</span>
      <h2 id="faq-heading">Heeft u vragen?</h2>
      <p>
        Bekijk de antwoorden op vragen die we regelmatig krijgen over maatwerk, levering en
        plaatsing.
      </p>
    </div>

    <div class="faq-section__list">
      {faqs.map(({ id, data, Content }, index) => {
        const triggerId = `faq-trigger-${id}`;
        const answerId = `faq-answer-${id}`;
        const isOpen = index === 0;

        return (
          <article class:list={['faq-item', { 'faq-item--open': isOpen }]} data-faq-item>
            <h3>
              <button
                id={triggerId}
                type="button"
                aria-expanded={isOpen ? 'true' : 'false'}
                aria-controls={answerId}
                data-faq-trigger
              >
                <span>{data.question}</span>
                <span class="faq-item__icon" aria-hidden="true">
                  <ChevronDown class="faq-item__chevron faq-item__chevron--down" />
                  <ChevronUp class="faq-item__chevron faq-item__chevron--up" />
                </span>
              </button>
            </h3>

            <div
              id={answerId}
              class="faq-item__answer"
              role="region"
              aria-labelledby={triggerId}
              aria-hidden={isOpen ? 'false' : 'true'}
              data-faq-answer
            >
              <div class="faq-item__answer-inner">
                <Content />
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq-item]').forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
    const answer = item.querySelector<HTMLElement>('[data-faq-answer]');

    if (!trigger || !answer) return;

    trigger.addEventListener('click', () => {
      const willOpen = trigger.getAttribute('aria-expanded') !== 'true';

      trigger.setAttribute('aria-expanded', String(willOpen));
      answer.setAttribute('aria-hidden', String(!willOpen));
      item.classList.toggle('faq-item--open', willOpen);
    });
  });
</script>

<style>
  .faq-section {
    padding-block: 4rem;
    background-color: var(--color-white);
  }

  .faq-section__layout {
    display: grid;
    gap: 4rem;
  }

  .faq-section__intro {
    display: grid;
    align-content: start;
    max-width: 43rem;
  }

  .faq-section__eyebrow {
    width: fit-content;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
  }

  .faq-section h2 {
    margin-bottom: 1rem;
  }

  .faq-section__list {
    display: grid;
    align-content: start;
    gap: 2rem;
  }

  .faq-item h3 {
    margin: 0;
  }

  .faq-item button {
    display: flex;
    width: 100%;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0;
    border: 0;
    font-family: var(--font-family-heading);
    font-size: var(--text-h6-size);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-h6-line-height);
    text-align: left;
    color: var(--color-heading);
    background: transparent;
  }

  .faq-item button:hover .faq-item__icon {
    color: var(--color-secondary);
  }

  .faq-item button:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 0.375rem;
    border-radius: 0.125rem;
  }

  .faq-item__icon {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    color: #A2A2A2;
    transition: color 200ms ease-out;
  }

  .faq-item__chevron {
    position: absolute;
    inset: 0;
    width: 1.5rem;
    height: 1.5rem;
    transition: opacity 200ms ease-out;
  }

  .faq-item__chevron--up {
    opacity: 0;
  }

  .faq-item--open .faq-item__chevron--down {
    opacity: 0;
  }

  .faq-item--open .faq-item__chevron--up {
    opacity: 1;
  }

  .faq-item__answer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 220ms ease-out,
      opacity 180ms ease-out;
  }

  .faq-item--open .faq-item__answer {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .faq-item__answer-inner {
    overflow: hidden;
  }

  .faq-item__answer-inner :global(p) {
    padding-top: 0.5rem;
  }

  @media (min-width: 64rem) {
    .faq-section {
      padding-block: 6rem;
    }

    .faq-section__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 6rem;
    }

    .faq-section h2 {
      margin-bottom: 1.5rem;
    }

    .faq-section__list {
      gap: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item__icon,
    .faq-item__chevron,
    .faq-item__answer {
      transition: none;
    }
  }
</style>
