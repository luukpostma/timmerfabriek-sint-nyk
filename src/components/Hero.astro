---
import { Image } from 'astro:assets';
import GoogleReviewStars from '../assets/icons/google-review.svg';
import heroImage from '../assets/images/loods.webp';
import Button from './Button.astro';
---

<section class="hero">
  <div class="container">
    <div class="hero__layout">
      <div class="hero__content">
        <div class="hero__copy">
          <div class="hero__review">
            <GoogleReviewStars class="hero__review-stars" aria-hidden="true" />
            <span>- 2 Google reviews</span>
          </div>

          <h1>Timmerfabriek voor houten maatwerk in Friesland</h1>

          <p>
            Vanuit onze werkplaats in Sint Nicolaasga maken we houten kozijnen, deuren en
            schuifpuien op maat. Met ruim 20 jaar vakervaring en persoonlijk contact leveren we
            aan particulieren en aannemers in Friesland en Noord-Nederland.
          </p>
        </div>

        <div class="hero__actions">
          <Button href="/contact/" variant="primary" arrow>Offerte aanvragen</Button>
          <Button href="/voor-aannemers/" variant="secondary">Samenwerken als aannemer</Button>
        </div>
      </div>

      <div class="hero__media">
        <Image
          class="hero__image"
          src={heroImage}
          alt="De loods van Timmerfabriek Sint Nyk"
          widths={[384, 576, 768, 1152]}
          sizes="(min-width: 80rem) 576px, (min-width: 64rem) calc((100vw - 112px) * 0.45), (min-width: 48rem) calc(100vw - 64px), calc(100vw - 32px)"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-section-y);
    color: var(--color-white);
    background-color: var(--color-primary);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--color-hero-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-hero-grid) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
  }

  .hero::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--color-primary),
      transparent 4.5rem,
      transparent calc(100% - 4.5rem),
      var(--color-primary)
    );
  }

  .hero > .container {
    position: relative;
    z-index: 1;
  }

  .hero__layout,
  .hero__content,
  .hero__copy,
  .hero__actions {
    display: grid;
  }

  .hero__layout {
    gap: 3rem;
  }

  .hero__content {
    gap: 2rem;
  }

  .hero__copy {
    gap: 1.5rem;
  }

  .hero__review {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-family-body);
    font-size: var(--text-body-small-size);
    line-height: var(--text-body-small-line-height);
    color: var(--color-white);
  }

  .hero__review-stars {
    width: 86px;
    height: 14px;
    flex: 0 0 auto;
    color: var(--color-review-star);
  }

  .hero h1 {
    color: var(--color-white);
  }

  .hero p {
    max-width: 38rem;
    color: rgb(255 255 255 / 88%);
  }

  .hero__actions {
    gap: 1rem;
  }

  :global(.hero__actions .button) {
    width: 100%;
  }

  @media (min-width: 36rem) {
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
    }

    :global(.hero__actions .button) {
      width: auto;
    }
  }

  .hero__media {
    width: 100%;
    height: 17.5rem;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .hero__media :global(.hero__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .hero__media {
      height: 24rem;
    }
  }

  @media (min-width: 64rem) {
    .hero__layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: 3rem;
    }

    .hero__content {
      gap: 3rem;
    }

    .hero__media {
      height: 24rem;
    }
  }

  @media (min-width: 80rem) {
    .hero__layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
    }

    .hero__media {
      height: 30rem;
    }
  }
</style>
