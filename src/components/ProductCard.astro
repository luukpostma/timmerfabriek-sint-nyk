---
import { Image } from 'astro:assets';
import ArrowRight from '../assets/icons/arrow-right.svg';
import type { ProductCardItem } from '../data/products';

interface Props {
  item: ProductCardItem;
  headingLevel?: 'h2' | 'h3';
}

const { item, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<a class="product-card" href={item.href}>
  <div class="product-card__media">
    <Image
      class="product-card__image"
      src={item.image}
      alt={item.alt}
      widths={[384, 768, 960, 1440]}
      sizes="(min-width: 80rem) 384px, (min-width: 64rem) calc((100vw - 128px) / 3), (min-width: 48rem) calc(100vw - 64px), calc(100vw - 32px)"
    />
  </div>

  <div class="product-card__content">
    <span class="product-card__eyebrow text-eyebrow">{item.eyebrow}</span>

    <div class="product-card__title-row">
      <Heading class="product-card__title">{item.title}</Heading>
      <ArrowRight class="product-card__arrow" aria-hidden="true" />
    </div>

    {item.description && <p>{item.description}</p>}
  </div>
</a>

<style>
  .product-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    color: var(--color-heading);
    background-color: var(--color-white);
    text-decoration: none;
    transition: border-color 200ms ease-out;
  }

  .product-card:hover {
    border-color: var(--color-secondary);
  }

  .product-card:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  .product-card__media {
    width: 100%;
    height: 16rem;
    overflow: hidden;
  }

  .product-card :global(.product-card__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease-out;
  }

  .product-card:hover :global(.product-card__image) {
    transform: scale(1.03);
  }

  .product-card__content {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 2rem;
  }

  .product-card__eyebrow {
    font-weight: var(--font-weight-semibold);
    color: var(--color-secondary);
  }

  .product-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .product-card__title {
    font-size: var(--text-h5-size);
    line-height: var(--text-h5-line-height);
  }

  .product-card__arrow {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    color: #A2A2A2;
    transition: color 200ms ease-out;
  }

  .product-card:hover .product-card__arrow {
    color: var(--color-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__arrow,
    .product-card :global(.product-card__image) {
      transition: none;
    }

    .product-card:hover :global(.product-card__image) {
      transform: none;
    }
  }
</style>
