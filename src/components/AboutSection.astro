---
import { Image } from 'astro:assets';
import aboutImage from '../assets/images/Overons.webp';
import Button from './Button.astro';

interface Props {
  buttonLabel?: string;
}

const { buttonLabel = 'Meer lezen' } = Astro.props;
---

<section class="about-section" aria-labelledby="about-heading">
  <Image
    class="about-section__background"
    src={aboutImage}
    alt=""
    widths={[768, 1024, 1440]}
    sizes="100vw"
    loading="lazy"
    aria-hidden="true"
  />

  <div class="container about-section__container">
    <div class="about-section__card">
      <span class="about-section__eyebrow text-eyebrow">Over ons</span>
      <h2 id="about-heading">Maatwerk begint in onze eigen werkplaats</h2>
      <p>
        In onze werkplaats in Sint Nicolaasga maken we ieder kozijn, iedere deur en schuifpui op
        maat. Met moderne machines, ervaren vakmensen en korte lijnen houden we het hele proces in
        eigen hand.
      </p>
      <Button class="about-section__button" href="/over-ons/" arrow>{buttonLabel}</Button>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 42.75rem;
    align-items: center;
    overflow: hidden;
    padding-block: 4rem;
    background-color: var(--color-primary);
  }

  .about-section__background {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .about-section::after {
    position: absolute;
    z-index: 0;
    inset: 0;
    content: '';
    pointer-events: none;
    background-color: rgb(0 0 0 / 60%);
  }

  .about-section__container {
    position: relative;
    z-index: 1;
  }

  .about-section__card {
    display: grid;
    width: 100%;
    padding: 2rem;
    border-radius: 0.75rem;
    background-color: var(--color-secondary);
  }

  .about-section__eyebrow {
    width: fit-content;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-white);
    border-radius: 9999px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-white);
  }

  .about-section h2 {
    margin-bottom: 1.5rem;
    color: var(--color-white);
  }

  .about-section p {
    color: var(--color-white);
  }

  :global(.about-section__button.button) {
    width: 100%;
    margin-top: 2rem;
    background-color: var(--color-primary);
  }

  :global(.about-section__button.button:hover:not(.button--disabled)) {
    background-color: var(--color-sub-navigation-background);
  }

  @media (min-width: 64rem) {
    .about-section {
      min-height: 45rem;
      padding-block: 6rem;
    }

    .about-section__background {
      object-position: center;
    }

    .about-section__card {
      max-width: 45rem;
      margin-inline: auto 2rem;
      padding: 4rem;
    }

    :global(.about-section__button.button) {
      width: fit-content;
    }
  }
</style>
