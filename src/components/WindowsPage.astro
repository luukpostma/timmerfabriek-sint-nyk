---
import type { NavigationItem } from '../data/navigation';
import CategoryHero from './CategoryHero.astro';
import ContractorSection from './ContractorSection.astro';
import FaqSection from './FaqSection.astro';
import WhyWindowsSection from './WhyWindowsSection.astro';
import WindowTypesSection from './WindowTypesSection.astro';

interface Props {
  page: NavigationItem;
}

const { page } = Astro.props;
---

<CategoryHero title={page.label} />
<WindowTypesSection items={page.children ?? []} />
<WhyWindowsSection />
<ContractorSection />
<FaqSection />
