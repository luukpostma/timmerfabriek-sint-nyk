---
import ArrowRight from '../assets/icons/arrow-right.svg';
import Mail from '../assets/icons/mail.svg';
import MapPin from '../assets/icons/map-pin.svg';
import Phone from '../assets/icons/phone.svg';
---

<section class="contact-section" aria-labelledby="contact-heading">
  <div class="container contact-section__layout">
    <div class="contact-section__content">
      <nav class="contact-section__breadcrumb text-eyebrow" aria-label="Broodkruimelpad">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>

      <h1 id="contact-heading">Contact</h1>
      <p>
        Heeft u een vraag of wilt u de mogelijkheden voor uw project bespreken? Neem gerust
        contact met ons op. We denken graag met u mee.
      </p>

      <address class="contact-section__details">
        <a href="tel:+31513123456">
          <span class="contact-section__icon"><Phone aria-hidden="true" /></span>
          <span>0513 – 123 456</span>
        </a>
        <a href="mailto:info@timmerfabrieksintnyk.nl">
          <span class="contact-section__icon"><Mail aria-hidden="true" /></span>
          <span>info@timmerfabrieksintnyk.nl</span>
        </a>
        <div>
          <span class="contact-section__icon"><MapPin aria-hidden="true" /></span>
          <span>Bovenkuier 38, 8521 MG Sint Nicolaasga</span>
        </div>
      </address>
    </div>

    <form class="contact-form" method="post" data-contact-form data-web3forms-ready>
      <h2>Neem contact met ons op</h2>

      <div class="contact-form__fields">
        <div class="contact-form__field">
          <label for="first-name">Voornaam <span aria-hidden="true">*</span></label>
          <input id="first-name" name="first_name" type="text" autocomplete="given-name" placeholder="Voornaam" required />
        </div>

        <div class="contact-form__field">
          <label for="last-name">Achternaam <span aria-hidden="true">*</span></label>
          <input id="last-name" name="last_name" type="text" autocomplete="family-name" placeholder="Achternaam" required />
        </div>

        <div class="contact-form__field contact-form__field--wide">
          <label for="email">E-mail <span aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="naam@mail.nl" required />
        </div>

        <div class="contact-form__field contact-form__field--wide">
          <label for="phone">Telefoonnummer</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="06-12345678" />
        </div>

        <div class="contact-form__field contact-form__field--wide">
          <label for="message">Bericht <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="5" placeholder="Typ hier uw bericht..." required></textarea>
        </div>
      </div>

      <button class="contact-form__submit" type="submit">
        <span>Versturen</span>
        <ArrowRight aria-hidden="true" />
      </button>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
    });
  });
</script>

<style>
  .contact-section {
    position: relative;
    padding-block: 4rem;
    overflow: hidden;
    color: var(--color-white);
    background-color: var(--color-primary);
  }

  .contact-section::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--color-hero-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-hero-grid) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
  }

  .contact-section::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--color-primary),
      transparent 4.5rem,
      transparent calc(100% - 4.5rem),
      var(--color-primary)
    );
  }

  .contact-section__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 4rem;
  }

  .contact-section__content {
    align-self: start;
  }

  .contact-section__breadcrumb {
    margin-bottom: 1rem;
  }

  .contact-section__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-section__breadcrumb li + li::before {
    margin-right: 0.375rem;
    color: rgb(255 255 255 / 64%);
    content: '/';
  }

  .contact-section__breadcrumb a {
    color: var(--color-white);
    text-decoration: none;
  }

  .contact-section__breadcrumb a:hover {
    color: var(--color-secondary);
  }

  .contact-section__breadcrumb a:focus-visible,
  .contact-section__details a:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 4px;
  }

  .contact-section h1 {
    color: var(--color-white);
  }

  .contact-section__content > p {
    max-width: 36rem;
    margin-top: 1rem;
    color: rgb(255 255 255 / 88%);
  }

  .contact-section__details {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
    font-style: normal;
  }

  .contact-section__details a,
  .contact-section__details > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    color: var(--color-white);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .contact-section__details a {
    width: fit-content;
    transition: color 200ms ease-out;
  }

  .contact-section__details a:hover {
    color: var(--color-secondary);
  }

  .contact-section__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 0.5rem;
    color: var(--color-secondary);
    background-color: var(--color-white);
  }

  .contact-section__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .contact-form {
    padding: 2rem;
    border-radius: 0.75rem;
    color: var(--color-heading);
    background-color: var(--color-white);
  }

  .contact-form h2 {
    margin-bottom: 2rem;
    font-family: var(--font-family-body);
    font-size: var(--text-h4-size);
    line-height: var(--text-h4-line-height);
  }

  .contact-form__fields {
    display: grid;
    gap: 1.5rem;
  }

  .contact-form__field {
    display: grid;
    gap: 0.5rem;
  }

  .contact-form label {
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
  }

  .contact-form label span {
    color: var(--color-secondary);
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #D4D4D4;
    border-radius: 0.5rem;
    color: var(--color-heading);
    background-color: var(--color-white);
    transition:
      border-color 200ms ease-out,
      box-shadow 200ms ease-out;
  }

  .contact-form input {
    min-height: 3rem;
  }

  .contact-form textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #858585;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    border-color: var(--color-secondary);
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgb(32 147 98 / 16%);
  }

  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.5rem;
    margin-top: 2rem;
    padding: 1rem 1.5rem;
    border: 0;
    border-radius: 9999px;
    font-family: var(--font-family-ui);
    font-size: var(--text-button-size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-button-line-height);
    color: var(--color-white);
    background-color: var(--color-secondary);
    transition: background-color 200ms ease-out;
  }

  .contact-form__submit:hover {
    background-color: var(--color-secondary-hover);
  }

  .contact-form__submit:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .contact-form__submit :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 200ms ease-out;
  }

  .contact-form__submit:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (min-width: 64rem) {
    .contact-section {
      padding-block: 6rem;
    }

    .contact-section__layout {
      grid-template-columns: minmax(0, 1fr) minmax(28rem, 30rem);
      align-items: start;
      gap: 6rem;
    }

    .contact-section__content {
      padding-top: 0.25rem;
    }

    .contact-form__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-form__field--wide {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-section__details a,
    .contact-form input,
    .contact-form textarea,
    .contact-form__submit,
    .contact-form__submit :global(svg) {
      transition: none;
    }

    .contact-form__submit:hover :global(svg) {
      transform: none;
    }
  }
</style>
